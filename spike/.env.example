# Copie este arquivo para .env.local e preencha.
# O .env.local NUNCA vai para o Git.

# Do painel do seu app em developers.facebook.com → Configurações do app → Básico
META_APP_ID=
META_APP_SECRET=

# Versão da Graph API (nov/2026: v26.0)
META_API_VERSION=v26.0

# Opcional: só se o seu app usar "Login do Facebook para Empresas" com configuração
META_LOGIN_CONFIG_ID=

# Preenchidos automaticamente pelos scripts `npm run login` ou `npm run token`
META_ACCESS_TOKEN=
META_TOKEN_EXPIRES_AT=
